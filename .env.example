# Database Configuration
DB_USERNAME=hubble_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
# IMPORTANT: Generate a secure 256-bit key for production!
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-for-hs256-algorithm-change-this-in-production
JWT_ISSUER=hubble-api
JWT_ACCESS_TTL=15     # minutes
JWT_REFRESH_TTL=14    # days

# Google OAuth2
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Naver OAuth2
# Get credentials from: https://developers.naver.com/apps/
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# Kakao OAuth2
# Get credentials from: https://developers.kakao.com/console/app
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# Server Configuration
SERVER_PORT=8080

# Elasticsearch Configuration
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Media Upload Configuration
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_FILE_SIZE=10MB
MEDIA_BASE_URL=http://localhost:8080

# Spring Profile (dev/prod)
SPRING_PROFILES_ACTIVE=dev
